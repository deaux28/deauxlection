# Supabase project settings → API. Either the publishable key (sb_publishable_…) or the legacy anon key works.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Only these email addresses can sign in (comma-separated).
ALLOWED_EMAILS=you@example.com

# Discogs personal access token: https://www.discogs.com/settings/developers
# Optional. Without it, record lookups use MusicBrainz only.
DISCOGS_TOKEN=

# Currency for prices paid (ISO code). Defaults to USD.
NEXT_PUBLIC_CURRENCY=USD
